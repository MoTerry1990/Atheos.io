# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env
.env.local
.env.*.local

# prisma generated client
/lib/generated

# misc
.DS_Store
*.pem
coverage

# Playwright. `test-results` holds traces and screenshots of failures and
# `playwright-report` is the HTML viewer — both are regenerated by every run
# and neither belongs in the repository.
/test-results/
/playwright-report/

# The configuration template is documentation, not a secret. The broad
# `.env*` rule above would otherwise exclude it and leave anyone cloning this
# repository with no list of what to set.
!.env.example

# Stray personal files that are not part of this project.
*.txt
!requirements.txt

.vercel
.env*

# Canonical provider masters for marketing derivatives.
#
# The 44 MB hero master is kept byte-for-byte so the published derivative can
# always be traced back to it, and so the authenticated original survives even
# though transcoding invalidates its C2PA manifest. It is deliberately not in
# git: a repository is the wrong place for tens of megabytes of binary that
# never changes. `docs/MEDIA-PROVENANCE.md` records its SHA-256, so a copy can
# be verified as the same bytes wherever it is stored.
/media-source/
