{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/worker/tick",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/worker/tick/route.ts": {
      "maxDuration": 60
    },
    "app/api/generations/route.ts": {
      "maxDuration": 60
    },
    "app/api/uploads/route.ts": {
      "maxDuration": 60
    }
  }
}
