# =============================================================================
# Atheos.io — environment
#
# Copy to .env.local and fill in. .env.local is git-ignored; never commit real
# values. Every variable here is validated in lib/env.ts — a missing or
# malformed one fails the build rather than the request.
#
# Variables marked REQUIRED must be present for `npm run build` to succeed.
# The rest are optional until the sprint that needs them.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# REQUIRED. Absolute origin, no trailing slash. Used for OAuth callbacks,
# webhook URLs, and absolute links in emails and Open Graph tags.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
#
# Two connection strings, deliberately. Supabase → Project Settings → Database.
#
#   DATABASE_URL  transaction pooler, port 6543, ?pgbouncer=true
#                 the running app uses this via the pg driver adapter
#   DIRECT_URL    session connection, port 5432
#                 Prisma Migrate uses this — the pooler cannot run DDL or hold
#                 the advisory locks migrations depend on
#
# Using the pooler for migrations appears to work in development and deadlocks
# in production. Keep them separate.
# -----------------------------------------------------------------------------
# REQUIRED
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# REQUIRED
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
# Identity — Clerk
#
# Clerk owns identity. Our `users` table mirrors it, keyed on clerkId, and is
# reconciled by the webhook below.
# -----------------------------------------------------------------------------
# REQUIRED — safe to expose, ships in the browser bundle
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# REQUIRED — server only
CLERK_SECRET_KEY="sk_test_..."
# Signing secret from the Clerk dashboard webhook config. Without verification,
# anyone who discovers the endpoint can create users in our database.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."


# -----------------------------------------------------------------------------
# Supabase client
#
# There is none, and there are no variables here.
#
# Supabase is our Postgres host and nothing else — reached only through
# DATABASE_URL and DIRECT_URL above. The JS client was installed in Sprint 0
# and never imported: Clerk owns sessions, so row-level security cannot see who
# is asking, which makes the anon-key + RLS path unusable by design.
#
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY were removed in Sprint 14. The service-role key in
# particular bypasses RLS entirely and was protecting nothing while sitting in
# every deployment's configuration.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Billing — Stripe
#
# Stripe is the source of truth for subscription state. Our tables mirror it.
# -----------------------------------------------------------------------------
# REQUIRED
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally, or the dashboard endpoint in production.
# An unverified billing webhook is a way for a stranger to grant themselves
# credits.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price ids, created in the Stripe dashboard. They differ per account and
# between test and live mode, so they cannot be committed — the amounts and
# credit allowances live in services/billing/catalogue.ts instead.
#
# A plan with no price id is shown but not purchasable, and asking to buy it
# fails with a message naming the missing variable rather than silently doing
# nothing. Without STRIPE_WEBHOOK_SECRET, a completed payment would never grant
# anything, so billing reports itself unconfigured until it is set.
# Named after the PlanTier enum value, not the display name:
#   BASIC = "Starter" $5   STUDIO = "Creator" $15.99
#   SCALE = "Studio" $35.99   AGENCY = "Agency" $199
# One per paid plan, monthly only — annual billing was retired.
# The name is the PlanTier value, which is also the plan's public name.
STRIPE_PRICE_CREATOR_MONTHLY="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_STUDIO_MONTHLY="price_..."

# One-off credit packs. `payment` mode, not subscriptions.
STRIPE_PRICE_PACK_1000="price_..."
STRIPE_PRICE_PACK_5000="price_..."
STRIPE_PRICE_PACK_20000="price_..."


# Administration
# -----------------------------------------------------------------------------
# Comma-separated Clerk user ids with access to /admin.
#
# The root of trust. `User.role = ADMIN` also grants access, but this list is
# checked without touching the database — so a database compromise alone cannot
# escalate anybody, and it is the recovery path if the column is ever wrong.
#
# Leave it empty and nobody can reach the dashboard except via the role column,
# with no way back if that is misconfigured. The status page warns when it is.
ADMIN_USER_IDS="user_2abc...,user_2def..."

# ---------------------------------------------------------------------------
# Financial circuit breakers (Sprint 4)
# ---------------------------------------------------------------------------
#
# All optional. Absent means "not tripped" — the safe default needs no
# configuration to be correct.
#
# They live in the environment rather than the database on purpose: a kill
# switch whose off position is a database row can be flipped by anything that
# can write to the database, including the bug you are trying to stop.
#
# Operating instructions: docs/OPERATIONS.md

# Stop every generation, immediately, for everyone. "1" to arm.
# ATHEOS_KILL_SWITCH="1"

# Stop Free-plan generations only. Paid users unaffected. Pull this first when
# spend climbs — free usage earns nothing.
# ATHEOS_FREE_GENERATION_DISABLED="1"

# Comma-separated provider ids to refuse.
# ATHEOS_DISABLED_PROVIDERS="replicate,openai"

# Comma-separated model ids to refuse.
# ATHEOS_DISABLED_MODELS="replicate/video-pro"

# What the provider has actually invoiced this month, in US dollars.
#
# Atheos accumulates its own estimate as generations run, built from cost
# figures that are mostly estimates rather than invoices. The breaker reads
# estimate + this number, so an undercount is always correctable upward without
# a deploy. Set it from the provider dashboard during reconciliation, and reset
# it to 0 at the start of each month.
# ATHEOS_MANUAL_SPEND_USD="0"


# -----------------------------------------------------------------------------
# Background worker
#
# Generation is processed by a server-side worker, not by the browser. Something
# has to trigger it on a schedule — a platform cron, or an external scheduler
# hitting POST /api/worker/tick.
#
# WORKER_TRIGGER_SECRET authenticates that trigger. Without it the endpoint
# refuses to run: an open worker trigger lets a stranger make us do work, and
# the work costs money.
#
# WEBHOOK_SIGNING_SECRET signs outbound callbacks. Without it we refuse to
# deliver rather than sending unsigned.
#
# Both must be at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
WORKER_TRIGGER_SECRET="..."
WEBHOOK_SIGNING_SECRET="..."


# -----------------------------------------------------------------------------
# Uploads
#
# There is no UploadThing variable. It was installed in Sprint 0 and never
# used: /api/uploads takes multipart form data and writes straight to R2 via
# services/storage/assets, so reference images and generated output share one
# storage path. The package and this variable were removed in Sprint 14.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# AI providers
#
# Presence enables a provider. Set none and the app falls back to an explicitly
# labelled mock provider — the studio still works end to end (jobs, credits,
# storage, refunds) but produces placeholder images, and says so in the UI.
#
# Replicate covers all five operations: text-to-image, image-to-image, upscale,
# background removal and variations. OpenAI covers generation and edits only.
# -----------------------------------------------------------------------------
REPLICATE_API_TOKEN="r8_..."
OPENAI_API_KEY="sk-..."
# Gemini image generation. The adapter is written but has never run against
# Google — see AI_PROVIDER_REPORT.md before relying on it.
GOOGLE_AI_API_KEY="AIza..."


# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2
#
# Where generated media lives. R2 is S3-compatible, so the AWS SDK talks to it
# unchanged. Chosen over S3 for one decisive reason: zero egress fees. A
# platform that serves generated video pays more to *deliver* bytes than to
# store them, and R2 removes that line item entirely.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="atheos-assets"
# Public hostname the bucket is served from (r2.dev or a custom domain).
# Deliberately separate from the bucket name: asset rows store object keys, not
# absolute URLs, so this can change without a data migration.
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.atheos.io"


# -----------------------------------------------------------------------------
# Escape hatch
#
# Skips env validation. For Docker image builds and CI lint jobs where secrets
# are legitimately absent. Never set this in an environment that serves traffic.
# -----------------------------------------------------------------------------
# SKIP_ENV_VALIDATION=1


# -----------------------------------------------------------------------------
# Content-Security-Policy
#
# As of Sprint 15 the CSP is ENFORCING by default. Set this to "1" to fall back
# to `Content-Security-Policy-Report-Only`, which observes and blocks nothing.
#
# Use it only to diagnose. A report-only policy that nobody is reading reports
# from is a header that does nothing, which is what this was for two sprints.
#
# Read directly by next.config.ts rather than through lib/env.ts, because it is
# consumed while building the header list, before the app exists.
# -----------------------------------------------------------------------------
# CSP_REPORT_ONLY=1

# ---------------------------------------------------------------------------
# Test databases (optional; never production)
# ---------------------------------------------------------------------------
#
# MIGRATION_TEST_DATABASE_URL — the managed atheos-test project, Session
# Pooler (port 5432). Used by tests/db/managed-*.test.ts, which run entirely
# inside a uniquely-named, disposable `atheos_migration_test_<hex>` schema and
# drop only that schema afterwards. The harness refuses the production project
# ref outright and fails closed if identity cannot be proven.
#
# Paste the Session Pooler string from Supabase and replace [YOUR-PASSWORD]
# INCLUDING the square brackets — leaving them in is a password of the wrong
# value, and Postgres reports it only as 'password authentication failed'.
MIGRATION_TEST_DATABASE_URL="postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# TEST_DATABASE_URL — a DISPOSABLE LOCAL PostgreSQL server only.
# This path still runs `DROP SCHEMA public CASCADE`, so the harness refuses any
# value containing `supabase` or `pooler`. For a managed server use
# MIGRATION_TEST_DATABASE_URL above, which isolates by schema instead.
#   docker run -d -p 5433:5432 -e POSTGRES_PASSWORD=x postgres:17
TEST_DATABASE_URL="postgres://postgres:x@localhost:5433/postgres"
