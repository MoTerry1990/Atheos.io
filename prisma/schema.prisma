// Atheos.io — data model
//
// Three principles hold this schema together:
//
// 1. External systems own their own truth. Clerk owns identity, Stripe owns
//    billing state. Rows here are *mirrors*, reconciled by webhook, and are
//    never the place a conflict is resolved.
//
// 2. Credits are an append-only ledger. `User.creditBalance` is a cached sum,
//    written in the same transaction as the ledger entry that changed it. A
//    balance you can only mutate is a balance you cannot audit or refund.
//
// 3. Generations and assets are separate. One generation can produce many
//    assets, an asset can outlive the generation's metadata, and uploads have
//    no generation at all.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 removed connection URLs from the schema. There are now two distinct
// connections, which is a better description of reality than one URL ever was:
//
//   migrations  DIRECT_URL   — prisma.config.ts. Needs a real session on port
//                              5432; the pooler cannot run DDL or hold the
//                              advisory locks Migrate depends on.
//   runtime     DATABASE_URL — lib/prisma.ts, via the pg driver adapter.
//                              Supabase's transaction pooler on port 6543,
//                              because serverless opens and discards
//                              connections faster than Postgres can absorb.
datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------------------------
// Identity
// --------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  /// Clerk's user id. The join key to the identity provider, and the only
  /// thing that makes this row addressable from a session.
  clerkId String @unique

  email    String  @unique
  name     String?
  imageUrl String?

  /// Cached sum of `creditTransactions.amount`. Never write this outside the
  /// transaction that writes the ledger entry.
  creditBalance Int @default(0)

  /// Elevated access.
  ///
  /// **Not the root of trust.** `ADMIN_USER_IDS` in the environment is, and it
  /// is checked independently — see `services/admin/auth.ts`. This column lets
  /// a bootstrap admin grant access without a deploy; the environment list is
  /// what makes a database compromise insufficient on its own, and what
  /// recovers access if this column is ever wrong.
  role Role @default(USER)

  /// Public handle, used at `/u/{handle}`.
  ///
  /// Null until claimed. A profile is opt-in: signing up must not publish a
  /// page about somebody, and deriving a handle from their email would do
  /// exactly that.
  ///
  /// Stored lower-cased with a case-insensitive unique index enforced in the
  /// service, because `Ada` and `ada` being different people is an
  /// impersonation vector rather than a feature.
  handle String? @unique

  /// Shown on the public profile instead of `name`, which comes from Clerk and
  /// is often a real legal name somebody did not choose to publish.
  displayName String?
  bio         String? @db.Text
  /// One link. A list invites link farms and needs its own moderation.
  website     String?

  /// Denormalised, written with the follow that changed them.
  followerCount  Int @default(0)
  followingCount Int @default(0)

  /// Editorial. Set by us, never derived from follower count.
  featuredAt DateTime?

  posts     Post[]
  postLikes PostLike[]
  comments  Comment[]
  following Follow[]   @relation("Following")
  followers Follow[]   @relation("Followers")

  /// Stripe's customer id.
  ///
  /// On the user, not on `Subscription`, because a customer exists before a
  /// subscription does and can outlive one: somebody who only ever buys credit
  /// packs is a paying customer with no subscription at all. Hanging it off the
  /// subscription would force a fake subscription row to hold it.
  stripeCustomerId String? @unique

  subscription       Subscription?
  generations        Generation[]
  assets             Asset[]
  collections        Collection[]
  folders            Folder[]
  creditTransactions CreditTransaction[]
  marketplaceSaves   MarketplaceFavorite[]
  marketplaceItems   MarketplaceInstall[]
  apiKeys            ApiKey[]
  sequences          Sequence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("users")
}

// --------------------------------------------------------------------------
// Billing — mirrors of Stripe, never the source of truth
// --------------------------------------------------------------------------

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

/// Which plan a subscription is on.
///
/// Ours, not Stripe's. A price id is an identifier in a third party's system
/// that changes when marketing changes a number; entitlements must not. The
/// mapping from price id to tier lives in `services/billing/plans.ts` and is
/// resolved once, on the way in from a webhook.
///
/// ## The values *are* the plan names, since Sprint 4.1
///
/// They used to be `STARTER / BASIC / STUDIO / SCALE / AGENCY`, inherited from
/// an earlier five-tier line-up and left in place through two renames on the
/// grounds that a stored entitlement must not change meaning when marketing
/// renames a plan. That reasoning is right when subscriptions exist. Here none
/// ever did — Stripe was never configured — so the drift bought nothing and
/// cost a great deal: by Sprint 4 the enum said `AGENCY` for a plan the
/// pricing page called Studio, while `STUDIO` meant Creator. Every reader of
/// this schema had to hold a translation table in their head, and the Sprint 4
/// report reached the founder saying "AGENCY now represents the $89.99 tier",
/// which is precisely the sentence nobody should ever have to write.
///
/// So the values were rotated to match the product, once, while it was free:
///
///   STARTER -> FREE      $0
///   STUDIO  -> CREATOR   $9.99
///   SCALE   -> PRO       $34.99
///   AGENCY  -> STUDIO    $89.99
///   BASIC   -> dropped   the retired $5 tier, never sold
///
/// The rotation is why `20260814000000_financial_safety_and_plan_tiers`
/// rebuilds the type rather than issuing `ALTER TYPE ... RENAME VALUE`:
/// `STUDIO` has to become `CREATOR` in the same breath that `AGENCY` becomes
/// `STUDIO`, and Postgres cannot hold two values of one name in between.
///
/// **This window is now closed.** Once a subscription row exists, a value here
/// is somebody's paid entitlement and renaming it is a data migration with a
/// customer on the other end. Add a value; never rotate one.
enum PlanTier {
  FREE
  CREATOR
  PRO
  STUDIO
}

model Subscription {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String  @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?
  stripeProductId      String?

  /// Resolved from `stripePriceId` when the webhook lands. Stored so an
  /// entitlement check is a column read rather than a catalogue lookup that
  /// depends on environment variables being present.
  planTier PlanTier @default(FREE)

  /// Billing period. Monthly and yearly are the same tier at different
  /// cadences, so this is not part of `PlanTier` — it changes the invoice, not
  /// what the user can do.
  interval BillingInterval @default(MONTH)

  status SubscriptionStatus @default(INCOMPLETE)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  /// A pending downgrade, scheduled for the end of the paid period.
  ///
  /// Held here rather than applied immediately, because a downgrade must never
  /// take away what somebody has already paid for. Null when nothing is
  /// pending.
  scheduledTier PlanTier?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

/// Why credits moved.
///
/// `GENERATION_SPEND` and `GENERATION_REFUND` are the pre-Sprint-4 pair, kept
/// because the ledger is append-only and historical rows still carry them. New
/// work uses the reservation lifecycle below.
///
/// ## The lifecycle, and where the balance actually moves
///
///   RESERVATION  balance -= cost   taken *before* the provider is called
///   CAPTURE      balance unchanged  marks the reservation final
///   RELEASE      balance += cost    returns it when nothing was billable
///
/// Reserving debits immediately rather than holding a separate "reserved"
/// column. One number moves, `balance = sum(amount)` stays true, and a user
/// cannot spend the same credits twice while a job is in flight — which is the
/// whole failure this replaces.
///
/// CAPTURE writes an `amount: 0` row. It changes no balance and exists so the
/// ledger records *when* a reservation stopped being reversible, without
/// mutating the immutable row that created it.
enum CreditReason {
  SIGNUP_GRANT
  SUBSCRIPTION_GRANT
  PACK_PURCHASE
  GENERATION_SPEND
  GENERATION_REFUND
  MANUAL_ADJUSTMENT
  GENERATION_RESERVATION
  GENERATION_CAPTURE
  GENERATION_RELEASE
}

/// Append-only. Never updated, never deleted — a correction is a new row with
/// the opposite sign, so the history of a balance is always reconstructable.
model CreditTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Positive for grants and purchases, negative for spend.
  amount Int
  reason CreditReason

  /// Balance immediately after this entry, so a statement can be rendered
  /// without replaying the whole ledger.
  balanceAfter Int

  generationId String?
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  /// Stripe payment intent / invoice id where the credits came from money.
  stripeReference String?

  /// Set for operations that must not double-apply — webhook retries, client
  /// retries on a flaky connection. Unique, so the second attempt is rejected
  /// by the database rather than by application logic.
  idempotencyKey String? @unique

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

// --------------------------------------------------------------------------
// Generation
// --------------------------------------------------------------------------

enum Modality {
  IMAGE
  VIDEO
  AUDIO
}

/// What the request asked the model to do.
///
/// An enum rather than a string, unlike `provider` and `model`: operations are
/// a *product* concept we define, not a vendor's. The set is small, closed, and
/// worth having the database enforce.
enum GenerationOperation {
  TEXT_TO_IMAGE
  IMAGE_TO_IMAGE
  UPSCALE
  REMOVE_BACKGROUND
  VARIATIONS
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  TEXT_TO_AUDIO
}

enum GenerationStatus {
  QUEUED
  RUNNING
  /// Failed, but the failure was transient and another attempt is scheduled.
  ///
  /// Distinct from QUEUED on purpose. A job waiting for its first run and a job
  /// waiting out a backoff look identical in a status column, and they are not:
  /// one is normal, the other means a provider is misbehaving. Merging them
  /// hides a rising retry rate, which is the earliest signal of an outage.
  RETRYING
  SUCCEEDED
  FAILED
  CANCELED
}

model Generation {
  id String @id @default(cuid())

  /// The scene this clip belongs to, if it was made for a sequence.
  scene Scene?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  modality  Modality
  operation GenerationOperation @default(TEXT_TO_IMAGE)

  /// Provider slug, e.g. "openai". Deliberately a string, not an enum: adding
  /// a provider must not require a migration.
  provider String
  model    String

  /// The generation this one was derived from — an upscale, a background
  /// removal, or a set of variations. Self-referential so lineage survives
  /// without a join table, and `SetNull` so deleting an ancestor does not
  /// cascade away work the user still has.
  parentId String?
  parent   Generation?  @relation("GenerationLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children Generation[] @relation("GenerationLineage")

  prompt         String  @db.Text
  negativePrompt String? @db.Text

  /// Provider-specific request parameters, kept verbatim so a generation can be
  /// replayed exactly even after our own parameter mapping changes.
  parameters Json?

  status GenerationStatus @default(QUEUED)

  /// The provider's job handle, for polling and cancellation.
  providerJobId String?

  /// Failure detail shown to the user; provider errors are normalised into it.
  error String? @db.Text

  /// Credits actually debited. Held here as well as in the ledger so the cost
  /// survives independently of any accounting change.
  creditsCost Int @default(0)

  // ---- What this generation cost *us*, and how it behaved -----------------
  //
  // Added in Sprint 19. `creditsCost` above is what the user was charged;
  // everything here is operational truth about the request itself, and none of
  // it was recorded before — which is why PROJECT_AUDIT.md said unit economics
  // were unmeasurable and there was no way to answer "why was that slow".

  /// Provider cost in **micro-USD** (millionths of a dollar).
  ///
  /// Integer, for the same reason the credit ledger is: floating-point money
  /// stops adding up. Micro rather than cents because a fast image model is
  /// genuinely $0.003 and cents would round most of the catalogue to zero.
  ///
  /// Nullable and **never defaulted to zero**: null means "we have no cost
  /// basis for this model", and defaulting to 0 would make an unpriced model
  /// look like the most profitable one in the table.
  costMicroUsd Int?

  /// Milliseconds from our request leaving to the provider accepting the job.
  ///
  /// Submit latency only — not how long the generation took, which is
  /// `startedAt` to `completedAt`. Kept separate because they fail differently:
  /// a slow submit is the provider's API struggling, a slow completion is
  /// simply a large model.
  latencyMs Int?

  // ---- Units of work (Sprint 21) -------------------------------------------
  //
  // Cost is recorded in `costMicroUsd` above, but a single money column cannot
  // answer "why did last month cost more" — the answer is always one of these
  // moving. Recorded per generation so a report can attribute spend to the
  // thing that caused it rather than to a provider name.
  //
  // All nullable, all with no default. A video generation has no image count,
  // and defaulting it to 0 would make "zero images" and "not an image job"
  // indistinguishable in a SUM.

  /// Billable compute time reported by the provider, in milliseconds.
  ///
  /// Distinct from `latencyMs` (how long the API call took) and from
  /// startedAt→completedAt (how long we waited). This is what the vendor
  /// charges for, and only some vendors report it.
  gpuTimeMs Int?

  /// Images produced. Null for video and audio jobs.
  imageCount Int?

  /// Video produced, in seconds. Null for image and audio jobs.
  videoSeconds Int?

  /// Audio produced, in seconds. Null for image and video jobs.
  ///
  /// Recorded now although nothing generates audio yet, because adding it later
  /// means a second migration on a table that will be much larger by then.
  audioSeconds Int?

  /// Token usage, where the provider reports it.
  ///
  /// Only the text and vision providers do. Null on every image and video
  /// model, and that is a real absence rather than a zero.
  promptTokens     Int?
  completionTokens Int?

  /// The provider originally asked for, when the manager failed over.
  ///
  /// Null on the normal path. Non-null means `provider` above is *not* what the
  /// user chose — the record of a substitution, which they were told about.
  requestedProvider String?

  /// Every provider attempted, with the error each returned.
  ///
  /// Written by the Provider Manager. This is what a support conversation
  /// actually needs: not "it failed" but "Replicate timed out twice, then
  /// OpenAI accepted it".
  attempts Json?

  // ---- Worker queue (Sprint 20) --------------------------------------------
  //
  // Until now the browser was the job runner: a closed tab stopped a generation
  // advancing until someone reopened the studio. These columns are what let a
  // server-side worker own the job instead.

  /// 0–100 where the provider reports it, null where it does not.
  ///
  /// Never invented. A progress bar that moves on a timer rather than on real
  /// information is worse than a spinner, because it makes a promise about
  /// completion time that nothing is keeping.
  progress Int?

  /// How many times this job has been attempted, across all providers.
  attemptCount Int @default(0)

  /// When a retrying job becomes eligible again.
  ///
  /// The worker claims on `nextAttemptAt <= now()`, so backoff is expressed as
  /// data rather than as a sleeping process — which is the only form that
  /// survives the worker being restarted.
  nextAttemptAt DateTime?

  /// Claim fields. A worker sets both atomically when it takes a job.
  ///
  /// `lockedAt` is what makes a crashed worker recoverable: a lock older than
  /// the lease is reclaimable, so a job whose worker died is picked up rather
  /// than sitting in RUNNING forever.
  lockedAt DateTime?
  lockedBy String?

  /// Where to POST when this job reaches a terminal state.
  ///
  /// Optional. Set by API callers who cannot hold a connection open; the studio
  /// polls instead and sets nothing.
  webhookUrl       String?
  webhookDelivered Boolean @default(false)
  webhookAttempts  Int     @default(0)
  webhookLastError String? @db.Text

  logs GenerationLog[]

  assets             Asset[]
  creditTransactions CreditTransaction[]

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@index([provider, providerJobId])
  @@index([parentId])
  /// Cost reporting scans by provider over a window. Without this the margin
  /// query is a sequential scan over every generation ever made.
  @@index([provider, createdAt])
  /// The worker's claim query. Without this every tick scans the whole table to
  /// find a handful of runnable jobs, and the scan gets slower as history grows
  /// — so the queue would degrade in proportion to the product's success.
  @@index([status, nextAttemptAt])
  /// Reclaiming jobs from workers that died mid-run.
  @@index([status, lockedAt])
  /// Per-user usage reporting over a period. `status` is in the key so a report
  /// can exclude failed jobs without a filter step — which is most of the rows
  /// in a bad week.
  @@index([userId, status, createdAt])
  @@map("generations")
}

// --------------------------------------------------------------------------
// Assets
// --------------------------------------------------------------------------

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  OTHER
}

enum AssetSource {
  /// Produced by a generation, written server-side to R2.
  GENERATED
  /// Supplied by the user, written server-side to R2 by /api/uploads.
  UPLOADED
}

model Asset {
  id String @id @default(cuid())

  /// Sequences whose stitched output this is.
  sequenceOutputs Sequence[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Null for uploads — the user gave us this file, nothing generated it.
  generationId String?
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  kind   AssetKind
  source AssetSource

  /// Object key in the bucket. The canonical location; never store a
  /// fully-qualified URL as the primary reference, because the CDN hostname in
  /// front of the bucket is an operational detail that will change.
  storageKey String @unique

  mimeType  String
  sizeBytes Int

  width      Int?
  height     Int?
  durationMs Int?

  /// Content hash, for deduplication and integrity checks.
  checksum String?

  thumbnailKey String?

  collections CollectionAsset[]
  posts       Post[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, createdAt])
  @@index([generationId])
  @@index([checksum])
  @@map("assets")
}

/// A folder holding projects.
///
/// Deliberately **flat**: a folder contains projects, never other folders.
/// Nesting is one nullable `parentId` away, and adding it later is a migration
/// with no data loss — whereas shipping it now means cycle detection on move,
/// recursive counts, and a tree control, for a depth most libraries never
/// reach. See `docs/DECISIONS.md` § 22.
model Folder {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  /// Hue, 0–360. A colour rather than an icon: it survives being shrunk to a
  /// 8px dot in a sidebar, which an icon does not.
  hue Int @default(268)

  /// `SetNull`, never `Cascade`. Deleting a folder must not delete the work
  /// inside it — that is the single most destructive mistake this schema could
  /// make possible, and the projects simply become unfiled.
  projects Collection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("folders")
}

/// A project. `Collection` in storage, "project" everywhere a user can see.
model Collection {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// Free-text notes. Separate from `description`, which is the one-line
  /// summary shown on a card; this is the brief nobody wants truncated.
  notes String? @db.Text

  /// Loose labels. A `String[]` rather than a join table: tags here are
  /// per-user free text with no attributes of their own, and a Tag entity would
  /// be three tables and a rename cascade to store what an array stores.
  tags String[] @default([])

  /// Accent hue, 0–360.
  hue Int @default(268)

  /// Cover image for the card. An asset id, resolved on read — storing a URL
  /// would break the moment the CDN hostname changes.
  coverAssetId String?

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  /// Archived, not deleted. The row and every membership survive; the project
  /// simply stops appearing in the default view. This is what makes hard
  /// deletion an acceptable default for the delete action — there is a
  /// non-destructive way to make something go away.
  archivedAt DateTime?

  isFavorite Boolean @default(false)

  /// Drives the "Recent" view. Distinct from `updatedAt`, which moves when
  /// anything on the row changes — including an archive or a rename from a
  /// bulk action nobody would call "opening" it.
  lastOpenedAt DateTime?

  /// Public URL segment, `/u/{handle}/c/{publicSlug}`.
  ///
  /// Separate from the name so renaming a shared collection does not break a
  /// link somebody has already sent. Null until it is shared.
  publicSlug String?

  /// Null while private. A shared collection shows only the assets inside it
  /// that have themselves been published — see `services/community`, where
  /// that intersection is enforced rather than assumed.
  sharedAt DateTime?

  assets CollectionAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Names stay unique per user even across folders. Two projects called
  /// "Client work" in different folders is a support ticket waiting to happen,
  /// and it makes `Duplicate` responsible for generating a free name.
  @@unique([userId, name])
  /// Unique per user, not globally: two people may both share "Portfolio", and
  /// the URL is namespaced by handle so they cannot collide.
  @@unique([userId, publicSlug])
  @@index([userId, lastOpenedAt])
  @@index([userId, archivedAt])
  @@index([folderId])
  @@index([sharedAt])
  @@map("collections")
}

model CollectionAsset {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([collectionId, assetId])
  @@index([assetId])
  @@map("collection_assets")
}

// --------------------------------------------------------------------------
// Administration
// --------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

/// What an admin did.
///
/// ## Append-only, and not optional
///
/// An admin dashboard can read every user's email and adjust anybody's credit
/// balance. Without a log, "who granted this account 50,000 credits" has no
/// answer — and the first time that question is asked will be the worst
/// possible time to discover there is no record.
///
/// Written in the **same transaction** as the change it describes, so an action
/// cannot succeed unaudited. Reads are logged too, for the ones that expose
/// somebody else's data: opening a support view is a disclosure, and a log that
/// only records writes cannot answer "who looked at this account".
///
/// Nothing deletes from this table. A correction is a new row.
model AdminAuditLog {
  id String @id @default(cuid())

  /// The admin. Not a relation with a cascade — deleting a staff account must
  /// not erase what they did.
  actorId    String
  actorEmail String

  /// `credits.adjust`, `user.role`, `comment.delete`, `support.view`.
  action String

  /// What was acted on. A user id, a comment id, a post slug.
  subjectType String
  subjectId   String

  /// Enough to reconstruct the change without joining to a row that may since
  /// have moved on. Never contains secrets.
  detail Json?

  /// Free text. Required by the service for anything that moves money — an
  /// adjustment with no stated reason is one nobody can review.
  reason String? @db.Text

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectType, subjectId])
  @@index([action, createdAt])
  @@map("admin_audit_log")
}

// --------------------------------------------------------------------------
// Community
// --------------------------------------------------------------------------

/// A published piece of work.
///
/// ## Separate from `Asset`, deliberately
///
/// An asset is a file somebody generated. A post is a decision to show it to
/// strangers. Collapsing them into a `published` boolean on `Asset` would make
/// that decision an attribute of the file, and unpublishing would have nowhere
/// to put the caption, the publication date or the engagement — all of which
/// should survive a take-down and return if it goes back up.
///
/// It also keeps the blast radius small: nothing in the studio, the projects
/// page or the storage layer has to know this table exists.
///
/// ## Nothing is public by default
///
/// A row here exists only because somebody pressed Publish. The studio holds
/// people's unfinished and commercial work; a product that defaults it to
/// visible has misunderstood what it is holding.
model Post {
  id String @id @default(cuid())

  /// Short public identifier used in URLs. Not the cuid, which is long and
  /// leaks insertion order.
  slug String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  caption String? @db.Text

  /// Whether the prompt is shown publicly.
  ///
  /// Opt-in separately from publishing the image. A prompt is the part people
  /// most want to see and the part a professional is most likely to consider
  /// their method — so it is two decisions, not one.
  showPrompt Boolean @default(true)

  /// Null while withdrawn. The row survives a take-down so the engagement and
  /// the caption come back if it is republished.
  publishedAt DateTime?

  /// Editorially set by us. Never derived from popularity — see
  /// `services/community` for why featuring is a curatorial act.
  featuredAt DateTime?

  /// Denormalised counts.
  ///
  /// Written in the same transaction as the like or comment that changed them.
  /// A gallery of twenty-four cards would otherwise be twenty-four counting
  /// subqueries, and the count is on every card.
  likeCount    Int @default(0)
  commentCount Int @default(0)

  likes    PostLike[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@index([userId, publishedAt])
  @@index([featuredAt])
  @@map("posts")
}

model PostLike {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Composite primary key: liking twice is the same fact, and the database
  /// should say so rather than application code remembering to check.
  @@id([postId, userId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
  @@map("post_likes")
}

model Comment {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body String @db.Text

  /// Soft delete. A removed comment leaves a tombstone so the replies around it
  /// still make sense, and so a moderation decision can be reviewed rather than
  /// being a row that silently vanished.
  deletedAt DateTime?

  /// Set when somebody reports it. There is no automated moderation — this is
  /// a queue for a human, and the product says so rather than implying safety
  /// it does not have.
  reportedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([reportedAt])
  @@map("comments")
}

/// A follow.
///
/// Two ids on one row, with a composite key. `followerId` follows
/// `followingId` — named in full rather than `a`/`b` because getting the
/// direction backwards is the classic bug here and short names invite it.
model Follow {
  followerId String
  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("follows")
}

// --------------------------------------------------------------------------
// Marketplace
// --------------------------------------------------------------------------

/// What a marketplace item is.
enum MarketplaceKind {
  TEMPLATE
  PROMPT_PACK
  STYLE_PACK
  CHARACTER
  VOICE_PACK
}

/// A user's saved item.
///
/// ## There is no `MarketplaceItem` table
///
/// The catalogue is **code**, in `services/marketplace/catalogue.ts`, exactly
/// like the AI model registry. Items are first-party, versioned with the
/// repository, and reviewed like any other change; putting them in the database
/// would add a seed step to every environment and a migration to every copy
/// edit, in exchange for nothing anyone can use yet.
///
/// So these tables store the only marketplace facts that are genuinely
/// per-user: what someone saved, and what they installed. Both reference the
/// catalogue by `slug`.
///
/// When third-party publishing arrives, an `items` table joins alongside and
/// `slug` stays the key. That is why it is a string here rather than a foreign
/// key to something that does not exist.
model MarketplaceFavorite {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Catalogue slug. Not a foreign key — see above.
  itemSlug String

  createdAt DateTime @default(now())

  @@id([userId, itemSlug])
  @@index([userId, createdAt])
  @@map("marketplace_favorites")
}

/// An item a user has added to their workspace.
///
/// "Download" in the interface. Nothing is transferred — installing makes the
/// item's contents available in the studio — but *download* is the word people
/// expect on a marketplace, and inventing a different one to be technically
/// precise would just make the button harder to find.
model MarketplaceInstall {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemSlug String
  kind     MarketplaceKind

  /// What the catalogue said when this was installed.
  ///
  /// A copy, deliberately. Editing a pack in the repository must not silently
  /// change work somebody has already built on — a prompt that shifts under
  /// them is worse than one that is out of date. The interface can compare the
  /// snapshot against the current catalogue and offer an update.
  snapshot Json

  installedAt DateTime @default(now())

  @@id([userId, itemSlug])
  @@index([userId, kind])
  @@map("marketplace_installs")
}

/// A line in a job's history.
///
/// Persisted rather than logged to stdout because these are the answer to "what
/// happened to my generation" — a question asked by a user, days later, about a
/// job nobody was watching. `console.log` cannot answer that.
///
/// Deliberately append-only and deliberately not the audit log: this is
/// operational detail about one job, not a record of who did what.
model GenerationLog {
  id String @id @default(cuid())

  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  /// info | warn | error. A string, not an enum: adding a level should not
  /// need a migration, and nothing branches on it in the database.
  level   String
  message String @db.Text

  /// Structured detail — provider id, attempt number, error code. Kept separate
  /// from the message so it stays queryable.
  context Json?

  createdAt DateTime @default(now())

  /// Reading a job's history, oldest first. The only access pattern.
  @@index([generationId, createdAt])
  @@map("generation_logs")
}

// --------------------------------------------------------------------------
// Infrastructure
// --------------------------------------------------------------------------

/// Webhook idempotency. Stripe and Clerk both retry, and both can deliver out
/// of order. Inserting the event id first — and letting the unique constraint
/// reject duplicates — is the only reliable way to process each one once.
model WebhookEvent {
  id String @id

  source      String
  eventType   String
  processedAt DateTime @default(now())
  payload     Json?
  error       String?  @db.Text

  @@index([source, processedAt])
  @@map("webhook_events")
}

/// A credential an outside program uses to act as one user.
///
/// ## Only the hash is stored
///
/// `hash` is SHA-256 of the full key. The plaintext is shown once, at creation,
/// and never again — a database read must not yield working credentials, and a
/// support conversation must never be able to recover somebody's key. Losing it
/// means issuing a new one, which is the correct trade.
///
/// SHA-256 rather than bcrypt or argon2 deliberately: this is a 256-bit random
/// token, not a human-chosen password. There is no dictionary to attack and no
/// rainbow table to build, so the slow-hash property buys nothing and would cost
/// ~100ms on every API request.
///
/// ## `prefix` exists so a key is identifiable without being usable
///
/// The first characters — `atk_live_7f3a…` — are stored in clear so the settings
/// screen can show *which* key was used or revoked. On its own it authenticates
/// nothing.
///
/// ## Revoking, not deleting
///
/// `revokedAt` rather than a row delete, so `lastUsedAt` survives the
/// revocation. "This key was still being used yesterday" is exactly the question
/// asked immediately after a leak.
model ApiKey {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the person called it. "Claude Desktop", "n8n", "my laptop".
  name String

  /// Displayable, non-secret. Never sufficient to authenticate.
  prefix String

  /// SHA-256 of the full key, hex. Unique so a lookup is one indexed read
  /// rather than a scan-and-compare over every key in the table.
  hash String @unique

  /// Null until first use. Answers "is this key actually in use" before
  /// somebody revokes one and breaks a workflow they forgot about.
  lastUsedAt DateTime?

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("api_keys")
}

enum SequenceStatus {
  DRAFT
  GENERATING
  /// Every clip is done; the browser is concatenating them.
  STITCHING
  SUCCEEDED
  FAILED
}

/// One user-facing video assembled from many generated clips.
///
/// No model generates two minutes in one call — the ceiling is 7.5 to 12
/// seconds. Every product that appears to make long AI video is stitching, and
/// this is where Atheos does it. See SEQUENCES_SPEC.md for why the cap is two
/// minutes rather than five or thirty.
///
/// ## Scenes reuse Generation
///
/// A clip is an ordinary generation, so it inherits credits, retries, refunds,
/// R2 storage and the worker for free. A Sequence is a container and an
/// ordering, not a second pipeline. Getting this wrong would have meant a
/// parallel implementation of the most expensive code in the product.
model Sequence {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String?
  status SequenceStatus @default(DRAFT)

  /// What the user asked for. The clip count is derived from it and the
  /// model's clip length, so a change of model does not silently change the
  /// length of somebody's video.
  targetSeconds Int

  /// Shared by every clip. The single most effective coherence measure there
  /// is: same seed, different prompt keeps lighting and style from wandering
  /// between shots.
  seed Int?

  /// Reserved up front, in one transaction, so a sequence cannot start and
  /// then run out halfway. Unused clips are refunded on partial failure.
  creditsCost Int @default(0)

  /// The stitched MP4, once assembled.
  outputAssetId String?
  outputAsset   Asset?  @relation(fields: [outputAssetId], references: [id], onDelete: SetNull)

  scenes Scene[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@map("sequences")
}

/// One shot in a sequence.
model Scene {
  id String @id @default(cuid())

  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  /// Position in the final cut. Not the creation order — scenes can be
  /// reordered, and the concat must follow the cut rather than the database.
  index Int

  prompt String @db.Text

  /// The clip. Null until submitted; a failed scene keeps its generation so
  /// the error is still readable.
  generationId String?     @unique
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@unique([sequenceId, index])
  @@index([sequenceId])
  @@map("scenes")
}

/// Provider spend for one calendar month, and the circuit breaker's input.
///
/// ## Why a table and not a metric
///
/// The threshold check runs inside the same transaction as the credit
/// reservation, immediately before the provider is called. That has to be a
/// read the database can serve transactionally; an external metrics store
/// would be eventually consistent, which is the one property a spending
/// ceiling cannot have.
///
/// ## `manualBaselineMicroUsd` is the honest part
///
/// Atheos records what it *believes* each generation cost, from
/// `services/ai/cost.ts`. Four of those figures are unverified and none is the
/// provider's own invoice. So the counter tracks our estimate, and the manual
/// baseline is where the operator writes down what the provider actually
/// billed — reconciled by hand until a provider spend API is wired.
///
/// The breaker reads `spentMicroUsd + manualBaselineMicroUsd`, so an
/// underestimate can always be corrected upward without a deploy.
model BudgetUsage {
  /// `YYYY-MM`, UTC. The primary key, so the month is the identity.
  period String @id

  /// Accumulated from our own cost estimates, in micro-USD.
  spentMicroUsd BigInt @default(0)

  /// Operator-entered correction, from the provider's real invoice.
  manualBaselineMicroUsd BigInt @default(0)

  /// Split out so the free tier can be stopped without touching paid users.
  freeSpentMicroUsd BigInt @default(0)

  updatedAt DateTime @updatedAt

  @@map("budget_usage")
}

/// One rate-limit window, in the database rather than in memory.
///
/// ## Why Postgres and not Redis
///
/// The previous limiter was a `Map` in the lambda's memory, which on Vercel
/// means every concurrent instance kept its own counter — the effective limit
/// was `configured x instances`, and it loosened exactly when load made it
/// matter. It could not enforce anything.
///
/// Redis is the textbook answer and it is a second paid dependency on a
/// $500-a-month budget. Postgres is already here, already transactional, and
/// one upsert per request is well within Supabase's capacity at this scale.
/// The trade is written up in `docs/OPERATIONS.md`; Upstash is the documented
/// upgrade if request volume ever makes this the bottleneck.
///
/// Rows are disposable — a cleanup sweep drops expired windows.
model RateLimitBucket {
  /// `{policy}:{identifier}` — one row per caller per policy.
  ///
  /// The window start is *not* in the key. Encoding it would create a new row
  /// every window and leave the old ones to be swept; instead the upsert resets
  /// `count` and `expiresAt` in place when it finds an expired row. One row per
  /// caller per policy, forever, which is a bounded set.
  key String @id

  count Int @default(0)

  /// When this window ends. Rows past it are dead and swept.
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
